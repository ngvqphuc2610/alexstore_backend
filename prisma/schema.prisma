// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum MembershipLevel {
  NORMAL
  SILVER
  GOLD
  VIP
}

enum SellerType {
  STANDARD
  MALL
  PRO
}

enum SupportRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum SellerVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           Bytes      @id @db.Binary(16)
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(BUYER)
  status       UserStatus @default(ACTIVE)
  phoneNumber  String?    @map("phone_number") @db.VarChar(20)
  address      String?    @db.Text
  isDeleted    Boolean    @default(false) @map("is_deleted")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  otpHash      String?    @map("otp_hash") @db.VarChar(255)
  otpExpireAt  DateTime?  @map("otp_expire_at")

  buyerProfile  BuyerProfile?
  sellerProfile SellerProfile?
  notificationSettings UserNotificationSettings?
  products      Product[]
  cart          Cart?
  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  supportRequests SupportRequest[]
  favorites     Favorite[]
  notifications Notification[]
  follows       Follow[]           @relation("BuyerFollows")
  followers     Follow[]           @relation("SellerFollowers")
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  sentMessages  Message[]          @relation("SentMessages")

  @@index([role], name: "idx_users_role")
  @@index([status], name: "idx_users_status")
  @@index([createdAt], name: "idx_users_created")
  @@map("users")
}

model UserNotificationSettings {
  userId            Bytes    @id @map("user_id") @db.Binary(16)
  emailOrderUpdates Boolean  @default(true) @map("email_order_updates")
  emailMarketing    Boolean  @default(true) @map("email_marketing")
  emailSellerAlerts Boolean  @default(true) @map("email_seller_alerts")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model BuyerProfile {
  userId          Bytes           @id @map("user_id") @db.Binary(16)
  membershipLevel MembershipLevel @default(NORMAL) @map("membership_level")
  loyaltyPoints   Int             @default(0) @map("loyalty_points")
  totalSpent      Decimal         @default(0.00) @map("total_spent") @db.Decimal(15, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

model SellerProfile {
  userId             Bytes                    @id @map("user_id") @db.Binary(16)
  shopName           String                   @map("shop_name") @db.VarChar(100)
  sellerType         SellerType               @default(STANDARD) @map("seller_type")
  verificationStatus SellerVerificationStatus @default(PENDING) @map("verification_status")
  taxCode            String?                  @map("tax_code") @db.VarChar(50)
  shopRating         Decimal                  @default(0.00) @map("shop_rating") @db.Decimal(3, 2)
  pickupAddress      String?                  @map("pickup_address") @db.Text
  description        String?                  @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  parentId Int?      @map("parent_id")
  parent   Category? @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]
  allowedSellerTypes CategoryAllowedSellerType[]

  @@map("categories")
}

model CategoryAllowedSellerType {
  id         Int        @id @default(autoincrement())
  categoryId Int        @map("category_id")
  sellerType SellerType @map("seller_type")
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, sellerType])
  @@map("category_allowed_seller_types")
}

model Product {
  id            Bytes         @id @db.Binary(16)
  sellerId      Bytes         @map("seller_id") @db.Binary(16)
  categoryId    Int           @map("category_id")
  name          String        @db.VarChar(255)
  description   String?       @db.Text
  price         Decimal       @db.Decimal(15, 2)
  stockQuantity Int           @default(0) @map("stock_quantity")
  avgRating     Decimal       @default(0.00) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount   Int           @default(0) @map("review_count")
  status        ProductStatus @default(PENDING)
  isDeleted     Boolean       @default(false) @map("is_deleted")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  seller     User           @relation(fields: [sellerId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  chatReferences Message[] @relation("ProductReferences")

  @@index([sellerId], name: "idx_products_seller")
  @@index([categoryId], name: "idx_products_category")
  @@index([status], name: "idx_products_status")
  @@index([createdAt], name: "idx_products_created")
  @@index([avgRating], name: "idx_products_rating")
  @@map("products")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId Bytes   @map("product_id") @db.Binary(16)
  imageUrl  String  @map("image_url") @db.VarChar(500)
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], name: "idx_product_images_product")
  @@map("product_images")
}

model Cart {
  id        Bytes    @id @db.Binary(16)
  buyerId   Bytes    @unique @map("buyer_id") @db.Binary(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id        BigInt @id @default(autoincrement())
  cartId    Bytes  @map("cart_id") @db.Binary(16)
  productId Bytes  @map("product_id") @db.Binary(16)
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId], name: "uq_cart_product")
  @@index([cartId], name: "idx_cart_items_cart")
  @@map("cart_items")
}

model Order {
  id                   Bytes         @id @db.Binary(16)
  orderCode            String        @unique @map("order_code") @db.VarChar(30)
  buyerId              Bytes         @map("buyer_id") @db.Binary(16)
  totalAmount          Decimal       @default(0) @map("total_amount") @db.Decimal(15, 2)
  status               OrderStatus   @default(PENDING)
  paymentMethod        String?       @map("payment_method") @db.VarChar(50)
  paymentStatus        PaymentStatus @default(UNPAID) @map("payment_status")
  paymentTransactionId String?       @map("payment_transaction_id") @db.VarChar(100)
  paidAt               DateTime?     @map("paid_at")
  shippingName         String        @default("Unspecified") @map("shipping_name") @db.VarChar(100)
  shippingPhone        String        @default("0000000000") @map("shipping_phone") @db.VarChar(20)
  shippingAddress      String        @map("shipping_address") @db.Text
  isDeleted            Boolean       @default(false) @map("is_deleted")
  deliveredAt          DateTime?     @map("delivered_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  buyer      User        @relation(fields: [buyerId], references: [id])
  orderItems OrderItem[]
  chatReferences Message[] @relation("OrderReferences")

  @@index([buyerId], name: "idx_orders_buyer")
  @@index([status], name: "idx_orders_status")
  @@index([createdAt], name: "idx_orders_created")
  @@map("orders")
}

model OrderItem {
  id              BigInt  @id @default(autoincrement())
  orderId         Bytes   @map("order_id") @db.Binary(16)
  productId       Bytes   @map("product_id") @db.Binary(16)
  quantity        Int
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId], name: "idx_order_items_order")
  @@map("order_items")
}

model Review {
  id        BigInt   @id @default(autoincrement())
  productId Bytes    @map("product_id") @db.Binary(16)
  buyerId   Bytes    @map("buyer_id") @db.Binary(16)
  rating    Int      @db.TinyInt
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  buyer   User    @relation(fields: [buyerId], references: [id])

  @@unique([buyerId, productId], name: "uq_review_user_product")
  @@index([productId], name: "idx_reviews_product")
  @@map("reviews")
}

model SupportRequest {
  id          Int                  @id @default(autoincrement())
  userId      Bytes                @map("user_id") @db.Binary(16)
  type        String               @db.VarChar(50) // e.g., "CATEGORY_REQ", "BUG", "TECHNICAL", "OTHER"
  title       String               @db.VarChar(255)
  description String               @db.Text
  status      SupportRequestStatus @default(PENDING)
  adminReply  String?              @map("admin_reply") @db.Text
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_support_requests_user")
  @@index([status], name: "idx_support_requests_status")
  @@map("support_requests")
}

model DailyPerformanceStats {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  sellerId    Bytes    @map("seller_id") @db.Binary(16)
  categoryId  Int      @map("category_id")
  revenue              Decimal  @default(0.00) @db.Decimal(15, 2)
  ordersCount          Int      @default(0) @map("orders_count")
  completedOrdersCount Int      @default(0) @map("completed_orders_count")
  cancelledOrdersCount Int      @default(0) @map("cancelled_orders_count")
  unitsSold            Int      @default(0) @map("units_sold")

  @@unique([date, sellerId, categoryId], name: "uq_daily_stats")
  @@index([date])
  @@index([sellerId])
  @@index([categoryId])
  @@map("daily_performance_stats")
}

model Address {
  id          Bytes    @id @db.Binary(16)
  userId      Bytes    @map("user_id") @db.Binary(16)

  fullName    String   @map("full_name") @db.VarChar(100)
  phoneNumber String   @map("phone_number") @db.VarChar(20)

  province    String   @db.VarChar(100)
  district    String   @db.VarChar(100)
  ward        String   @db.VarChar(100)
  addressLine String   @map("address_line") @db.VarChar(255)

  isDefault   Boolean  @default(false) @map("is_default")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_addresses_user")
  @@map("addresses")
}

model Favorite {
  id        BigInt   @id @default(autoincrement())
  userId    Bytes    @map("user_id") @db.Binary(16)
  productId Bytes    @map("product_id") @db.Binary(16)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], name: "uq_favorite_user_product")
  @@index([userId], name: "idx_favorites_user")
  @@index([productId], name: "idx_favorites_product")
  @@map("favorites")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    Bytes    @map("user_id") @db.Binary(16)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50) // e.g., "ORDER_UPDATE", "SYSTEM"
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_notifications_user")
  @@index([isRead], name: "idx_notifications_is_read")
  @@index([createdAt], name: "idx_notifications_created")
  @@map("notifications")
}

model EmailLog {
  id        BigInt   @id @default(autoincrement())
  to        String   @db.VarChar(100)
  subject   String   @db.VarChar(255)
  template  String   @db.VarChar(50)
  context   String?  @db.Text // JSON string of context
  status    String   @db.VarChar(20) // "SUCCESS", "FAILED"
  error     String?  @db.Text
  sentAt    DateTime @default(now()) @map("sent_at")

  @@index([to], name: "idx_email_logs_to")
  @@index([sentAt], name: "idx_email_logs_sent_at")
  @@map("email_logs")
}

model Follow {
  id        Bytes    @id @db.Binary(16)
  buyerId   Bytes    @map("buyer_id") @db.Binary(16)
  sellerId  Bytes    @map("seller_id") @db.Binary(16)
  createdAt DateTime @default(now()) @map("created_at")

  buyer     User     @relation("BuyerFollows", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User     @relation("SellerFollowers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, sellerId], name: "uq_follow_buyer_seller")
  @@index([buyerId], name: "idx_follows_buyer")
  @@index([sellerId], name: "idx_follows_seller")
  @@map("follows")
}

// ─── Chat ────────────────────────────────────────────────────────────────────

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  PRODUCT_REF
  ORDER_REF
}

model Conversation {
  id                Bytes    @id @db.Binary(16)
  buyerId           Bytes    @map("buyer_id") @db.Binary(16)
  sellerId          Bytes    @map("seller_id") @db.Binary(16)
  lastMessage       String?  @map("last_message") @db.VarChar(500)
  lastMessageAt     DateTime? @map("last_message_at")
  unreadCountBuyer  Int      @default(0) @map("unread_count_buyer")
  unreadCountSeller Int      @default(0) @map("unread_count_seller")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, sellerId], name: "uq_conversation_buyer_seller")
  @@index([buyerId], name: "idx_conversations_buyer")
  @@index([sellerId], name: "idx_conversations_seller")
  @@index([lastMessageAt], name: "idx_conversations_last_message")
  @@map("conversations")
}

model Message {
  id                  BigInt      @id @default(autoincrement())
  conversationId      Bytes       @map("conversation_id") @db.Binary(16)
  senderId            Bytes       @map("sender_id") @db.Binary(16)
  type                MessageType @default(TEXT)
  content             String      @db.Text
  referencedProductId Bytes?      @map("referenced_product_id") @db.Binary(16)
  referencedOrderId   Bytes?      @map("referenced_order_id") @db.Binary(16)
  isRead              Boolean     @default(false) @map("is_read")
  createdAt           DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  product      Product?     @relation("ProductReferences", fields: [referencedProductId], references: [id])
  order        Order?       @relation("OrderReferences", fields: [referencedOrderId], references: [id])

  @@index([conversationId, createdAt], name: "idx_messages_conv_created")
  @@index([senderId], name: "idx_messages_sender")
  @@map("messages")
}
